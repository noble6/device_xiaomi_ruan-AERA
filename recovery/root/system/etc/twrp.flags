# mount point   fstype  device  device2  flags
/system_ext     erofs   system_ext  flags=display="System_ext";logical;slotselect;backup=1;flashimg=1
/vendor_dlkm    erofs   vendor_dlkm flags=display="Vendor_dlkm";logical;slotselect;backup=1;flashimg=1
/odm            erofs   odm         flags=display="Odm";logical;slotselect;backup=1;flashimg=1
/product        erofs   product     flags=display="Product";logical;slotselect;backup=1;flashimg=1

/metadata       ext4    /dev/block/by-name/metadata flags=display="Metadata";backup=1

/boot           emmc    /dev/block/bootdevice/by-name/boot        flags=slotselect;backup=1;flashimg=1;display="Boot"
/vendor_boot    emmc    /dev/block/bootdevice/by-name/vendor_boot flags=slotselect;backup=1;flashimg=1;display="Vendor Boot"
/recovery       emmc    /dev/block/bootdevice/by-name/recovery    flags=slotselect;backup=1;flashimg=1;display="Recovery"
/dtbo           emmc    /dev/block/bootdevice/by-name/dtbo        flags=slotselect;backup=1;flashimg=1;display="DTBO"
/vbmeta         emmc    /dev/block/bootdevice/by-name/vbmeta      flags=slotselect;backup=1;flashimg=1;display="VBMeta"

/firmware       vfat    /dev/block/bootdevice/by-name/modem       flags=slotselect;display="Firmware";mounttodecrypt
/persist        ext4    /dev/block/bootdevice/by-name/persist     flags=display="Persist";backup=1

/external_sd    auto    /dev/block/mmcblk0p1  /dev/block/mmcblk0  flags=display="MicroSD";storage;wipeingui;removable;encryptable=userdata
/usbstorage     auto    /dev/block/sdg1       /dev/block/sdg      flags=display="USB OTG";storage;wipeingui;removable
